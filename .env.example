# Optional. Leave empty — the app runs fully on IndexedDB with zero keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Resend — server only. Never prefix with VITE_ (that would leak the key in the browser).
# Copy to .env locally. On Hostinger set the same names in the Web App environment.
RESEND_API_KEY=
RESEND_FROM=Socilet <noreply@socilet.in>

# Optional: extra persist file for mailboxes so Git deploys do not wipe connections.
# Default also writes ../.socilet-persist/mailboxes.json (outside the app folder).
# MAILBOX_STORE=
# DATA_DIR=
